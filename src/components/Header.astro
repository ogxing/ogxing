---
import { SITE } from '../consts';
import Search from './Search.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onIndex = path === '/';
---
<header class="site-header">
  <div class="container row">
    <div class="left">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>{SITE.name}</a>
      <nav class="nav" aria-label="Primary">
        <a href="/" aria-current={onIndex ? 'page' : undefined}>Research</a>
      </nav>
    </div>
    <div class="right">
      <Search />
      <button class="icon-btn menu-btn" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-nav">
        <svg class="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
        <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" style="display:none"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  <nav id="site-nav" class="site-nav" aria-label="Sections">
    <div class="container">
      <a href="/" aria-current={onIndex ? 'page' : undefined}>Research</a>
    </div>
  </nav>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('site-nav');
  if (btn && panel) {
    const menu = btn.querySelector<SVGElement>('.i-menu')!;
    const close = btn.querySelector<SVGElement>('.i-close')!;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      panel.toggleAttribute('data-open', open);
      document.body.toggleAttribute('data-menu-open', open);
      menu.style.display = open ? 'none' : '';
      close.style.display = open ? '' : 'none';
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
  }
</script>
